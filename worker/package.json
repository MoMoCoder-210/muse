{
  "name": "@muse/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node sidecar worker for task execution",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/prompts','dist/prompts',{recursive:true});fs.copyFileSync('../src/config/default-settings.json','dist/config/default-settings.json')\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "openai": "6.45.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
