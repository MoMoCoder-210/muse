{
  "name": "muse",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "桌面端AI视频视频创作工作流",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "kill:orphan-upscale": "node scripts/kill-orphan-upscale.mjs",
    "tauri:dev": "npm run kill:orphan-upscale && npm run worker:build && tauri dev",
    "tauri:build": "npm run kill:orphan-upscale && npm run fetch-node && npm run worker:build && tauri build",
    "fetch-node": "node scripts/fetch-node.mjs",
    "worker:dev": "npm run dev -w worker",
    "worker:build": "npm run build -w worker",
    "gen:voices": "node scripts/gen-public-voices.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.32",
    "@ai-sdk/openai": "^4.0.31",
    "@tanstack/react-query": "^5.66.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tiptap/extension-mention": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "ai": "^7.0.54",
    "mem0ai": "^3.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
