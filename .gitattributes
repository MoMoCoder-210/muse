# 所有文本文件统一使用 LF 行尾存储，检出时不转换
# 在 Windows 上避免 LF ↔ CRLF 来回转换导致 diff 污染
* text=auto eol=lf

# 明确声明文本文件类型
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.rs    text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 明确声明二进制文件，不做行尾处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
