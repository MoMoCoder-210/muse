{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse",
  "version": "0.3.0",
  "identifier": "com.muse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Muse",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#060912"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; connect-src 'self' asset: http://asset.localhost https://asset.localhost http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$APPDATA/**",
          "$LOCALDATA/**",
          "$APPLOCALDATA/**",
          "D:/**",
          "E:/**",
          "F:/**",
          "G:/**",
          "H:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../migrations/*": "migrations/",
      "../worker/dist/*": "worker/dist/",
      "../worker/dist/handlers/*": "worker/dist/handlers/",
      "../worker/dist/clients/*": "worker/dist/clients/",
      "../worker/dist/config/*": "worker/dist/config/",
      "../worker/dist/prompts/*": "worker/dist/prompts/",
      "../worker/dist/utils/*": "worker/dist/utils/",
      "../ffmpeg/*": "ffmpeg/",
      "../node/*": "node/",
      "../upscaler/*.dll": "upscaler/",
      "../upscaler/*.exe": "upscaler/",
      "../upscaler/models/*.param": "upscaler/models/",
      "../upscaler/models/*.bin": "upscaler/models/",
      "resources/voices/*": "resources/voices/",
      "../worker/dist/node_modules/base64-js/*": "worker/dist/node_modules/base64-js/",
      "../worker/dist/node_modules/better-sqlite3/build/Release/*": "worker/dist/node_modules/better-sqlite3/build/Release/",
      "../worker/dist/node_modules/better-sqlite3/deps/patches/*": "worker/dist/node_modules/better-sqlite3/deps/patches/",
