{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "默认应用权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-create-dir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename"
  ]
}
